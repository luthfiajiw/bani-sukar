# Database connection (Supabase Postgres or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_tree"

# JWT Authentication (gunakan string acak minimal 32 karakter)
JWT_SECRET="family-tree-jwt-secret-key-at-least-32-chars-long-2026"

# Supabase Storage (S3-compatible) untuk foto profil
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_STORAGE_BUCKET="person-photos"
SUPABASE_S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-southeast-1"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
